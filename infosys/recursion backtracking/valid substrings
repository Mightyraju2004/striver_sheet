 # find the number of valid strings of length N formed using the alphabet {a, b, c} such that:Every character (a,b, and c) appears at least once.The substring ab does not appear anywhere in the string.
#include <iostream>
#include <string>

using namespace std;

// Helper Function: String poori banne ke baad check karega ki a, b, c teeno hain ya nahi
bool isValid(const string& str) {
    bool has_a = false, has_b = false, has_c = false;
    
    for (char ch : str) {
        if (ch == 'a') has_a = true;
        if (ch == 'b') has_b = true;
        if (ch == 'c') has_c = true;
    }
    
    return (has_a && has_b && has_c);
}

// Pure Recursion Function
int generateStrings(string current, int N) {
    // Base Case: String ki length N ho gayi
    if (current.length() == N) {
        if (isValid(current)) {
            return 1;
        }
        return 0;
    }

    int count = 0;
    
    

    // Call 1: 'a' add karo
    count += generateStrings(current + 'a', N);

    // Call 2: 'b' add karo (Sirf tabhi jab pichla char 'a' na ho)
    if (current.empty() || current.back() != 'a') {
        count += generateStrings(current + 'b', N);
    }

    // Call 3: 'c' add karo
    count += generateStrings(current + 'c', N);

    return count;
}

int main() {
    int N;
    
    // SIRF N INPUT HOGA
    cin >> N;

    // Function call starting with empty string ""
    int ans = generateStrings("", N);
    
    cout << ans << endl;

    return 0;
}
