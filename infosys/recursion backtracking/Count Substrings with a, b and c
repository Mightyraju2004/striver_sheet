class Solution {
  public:
    int countSubstring(string &s) {
        // Code here
        int n = s.size();
       vector<int>freq(3,0);
        int i=0,j=0;
        int count=0;
        while(j<n){
            freq[s[j]-'a']++;
            
            while(freq[0]>0 && freq[1]>0 && freq[2]>0){
                count+=(n-j);
                
                freq[s[i]-'a']--;
                i++;
            }
            j++;
        }
     return count;
    }
};
