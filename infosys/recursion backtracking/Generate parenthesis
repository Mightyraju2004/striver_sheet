class Solution {
  public:
  vector<string>ans;
  bool isValid(string t){
      int p=t.length();
      int open=0;
      for(int i=0;i<p;i++){
          if(t[i]==')')
              open--;
          else open++;
          if(open<0) return false;
       }
       return open==0;
  }
  void solve(string temp,int i){
      if(i==0){
          if(isValid(temp)) ans.push_back(temp);
          return;
      }
      temp.push_back('(');//take
      solve(temp,i-1);//explore in that dirn
      temp.pop_back();//backtrack
      
      temp.push_back(')');//take 
      solve(temp,i-1);//explore in that way
  }
    vector<string> generateParentheses(int n) {
        // code here
        string temp="";
        solve(temp,n);
        return ans;
    }
};
