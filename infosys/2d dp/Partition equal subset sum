class Solution {
public:
int n;
int dp[201][20001];
bool solve(vector<int>&nums, int sum,int idx){
        if(sum==0) return true;
        if(sum<0 || idx>=n) return false;//nahi hua sum==0
        if(dp[idx][sum]!=-1) return dp[idx][sum];


        bool take=solve(nums,sum-nums[idx],idx+1);
        bool skip=solve(nums,sum,idx+1);

        return dp[idx][sum] = take || skip;
}
    bool canPartition(vector<int>& nums) {
        n=nums.size();
        int sum=0;
        for(int num:nums) sum+=num;

        if(sum%2 != 0) return false;

        memset(dp,-1,sizeof(dp));
         return solve(nums,sum/2,0);
    }
};
